# Upstash Redis / Vercel KV Configuration
# Get these from your Upstash console (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here

# Alternative keys (Vercel KV default names)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Dictionary API override
# Default: https://ord.uib.no/api/articles
DICTIONARY_API_URL=
# Default: https://odd.uib.no/opal/prod/api/articles (UiB backup, tried when the primary fails)
DICTIONARY_API_FALLBACK_URL=
REDIS_URL=